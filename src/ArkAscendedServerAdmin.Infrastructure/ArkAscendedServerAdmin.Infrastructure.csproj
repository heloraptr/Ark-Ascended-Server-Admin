<Project Sdk="Microsoft.NET.Sdk">

  <!-- EF Core + SQLite, SteamCMD runner, process manager (WMI), RCON client, junction layout,
       firewall, backups. Windows-only by design; anything referencing this project must also target
       net10.0-windows. -->

  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <RootNamespace>ArkAscendedServerAdmin.Infrastructure</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\ArkAscendedServerAdmin.Core\ArkAscendedServerAdmin.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.Extensions.Hosting.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Http" />
    <PackageReference Include="System.Management" />
    <PackageReference Include="CoreRCON" />
    <PackageReference Include="WindowsFirewallHelper" />
  </ItemGroup>

</Project>
