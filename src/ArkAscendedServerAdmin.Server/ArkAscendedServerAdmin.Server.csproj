<Project Sdk="Microsoft.NET.Sdk.Web">

  <!-- Blazor Server host: Kestrel + Windows service composition root. All screens come from
       ArkAscendedServerAdmin.Components; all Windows work comes from ArkAscendedServerAdmin.Infrastructure. -->

  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <RootNamespace>ArkAscendedServerAdmin.Server</RootNamespace>
    <UserSecretsId>89cee83a-d4ee-40d3-8100-6f858452acbd</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\ArkAscendedServerAdmin.Core\ArkAscendedServerAdmin.Core.csproj" />
    <ProjectReference Include="..\ArkAscendedServerAdmin.Infrastructure\ArkAscendedServerAdmin.Infrastructure.csproj" />
    <ProjectReference Include="..\ArkAscendedServerAdmin.Components\ArkAscendedServerAdmin.Components.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting.WindowsServices" />
    <PackageReference Include="Radzen.Blazor" />
    <!-- Startup project for `dotnet ef` (migrations live in Infrastructure). -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <!-- Third-party license notices ship next to the binaries (release plan step A6). -->
    <None Include="..\..\THIRD-PARTY-NOTICES.md" Link="THIRD-PARTY-NOTICES.md" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
