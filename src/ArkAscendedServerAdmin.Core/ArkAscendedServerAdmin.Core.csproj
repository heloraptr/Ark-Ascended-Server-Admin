<Project Sdk="Microsoft.NET.Sdk">

  <!-- Domain models, INI merge, port allocation, launch-argument builder, CurseForge client, service
       interfaces, cron schedules. No Windows dependencies, no DI packages: the only packages are the
       cron parser (Cronos) and the cron describer (CronExpressionDescriptor) behind Scheduling. -->

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>ArkAscendedServerAdmin</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="CronExpressionDescriptor" />
    <PackageReference Include="Cronos" />
  </ItemGroup>

  <ItemGroup>
    <!-- The login throttle tests read its per-address counters and verify-slot count (finding 6). -->
    <InternalsVisibleTo Include="ArkAscendedServerAdmin.UnitTests" />
    <InternalsVisibleTo Include="ArkAscendedServerAdmin.Infrastructure.IntegrationTests" />
  </ItemGroup>

</Project>
