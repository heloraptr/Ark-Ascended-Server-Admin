@inherits LayoutComponentBase
@implements IDisposable
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject IReadinessMonitor Readiness
@inject IUpdateService Updates
@inject NavigationManager Navigation

<RadzenComponents />

<div class="ark-shell">
    <Rail />
    <main class="ark-main">
        <div class="ark-horizon @HorizonClass" aria-hidden="true"></div>
        <div class="ark-page">
            @Body
        </div>
    </main>
</div>

<div id="blazor-error-ui" data-nosnippet>
    An unhandled error has occurred.
    <a href="." class="reload">Reload</a>
    <span class="dismiss">🗙</span>
</div>

@code {
    private ReadinessState _readiness = default!;
    private MaintenanceSnapshot _maintenance = default!;

    private string HorizonClass =>
        _readiness.Phase is ReadinessPhase.Failed or ReadinessPhase.InstallFailed ? "is-failed"
        : !_readiness.IsReady || _maintenance.Phase != MaintenancePhase.None ? "is-busy"
        : string.Empty;

    protected override void OnInitialized()
    {
        // Visibility is not authorization (the command facades re-check), but a circuit whose
        // revalidation failed must leave: forceLoad tears the circuit down and lands on the login page.
        AuthenticationStateProvider.AuthenticationStateChanged += OnAuthenticationStateChanged;
        Readiness.Changed += OnReadinessChanged;
        Updates.Changed += OnMaintenanceChanged;
        _readiness = Readiness.Current;
        _maintenance = Updates.Current;
        RedirectToSetupIfNotReady(_readiness);
    }

    private void OnAuthenticationStateChanged(Task<AuthenticationState> task) =>
        _ = InvokeAsync(async () =>
        {
            var state = await task;
            if (state.User.Identity is not { IsAuthenticated: true })
            {
                Navigation.NavigateTo("login", forceLoad: true);
            }
        });

    private void OnReadinessChanged(ReadinessState state) =>
        _ = InvokeAsync(() =>
        {
            _readiness = state;
            RedirectToSetupIfNotReady(state);
            StateHasChanged();
        });

    private void OnMaintenanceChanged(MaintenanceSnapshot snapshot) =>
        _ = InvokeAsync(() =>
        {
            _maintenance = snapshot;
            StateHasChanged();
        });

    private void RedirectToSetupIfNotReady(ReadinessState state)
    {
        if (state.IsReady)
        {
            return;
        }

        var path = Navigation.ToBaseRelativePath(Navigation.Uri);
        if (!path.StartsWith("setup", StringComparison.OrdinalIgnoreCase))
        {
            Navigation.NavigateTo("setup");
        }
    }

    public void Dispose()
    {
        AuthenticationStateProvider.AuthenticationStateChanged -= OnAuthenticationStateChanged;
        Readiness.Changed -= OnReadinessChanged;
        Updates.Changed -= OnMaintenanceChanged;
    }
}
