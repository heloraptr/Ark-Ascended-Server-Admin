@implements IDisposable
@inject IReadinessMonitor Readiness
@inject IUpdateService Updates
@inject IProcessManager Processes
@inject NotificationService Notifications
@inject NavigationManager Navigation
@inject HostConfiguration Host

<aside class="ark-rail">
    <a class="ark-brand" href="">
        <BrandMark />
        <span>
            <span class="ark-brand-name">ARK</span>
            <span class="ark-brand-sub">Ascended server admin</span>
        </span>
    </a>

    <nav class="ark-nav" aria-label="Main">
        <NavLink href="" Match="NavLinkMatch.All"><RadzenIcon Icon="dns" /> Instances</NavLink>
        <NavLink href="clusters"><RadzenIcon Icon="hub" /> Clusters</NavLink>
        <NavLink href="mods"><RadzenIcon Icon="extension" /> Mods</NavLink>
        <NavLink href="players"><RadzenIcon Icon="group" /> Players</NavLink>
        <NavLink href="maps"><RadzenIcon Icon="map" /> Maps</NavLink>
        <NavLink href="settings"><RadzenIcon Icon="tune" /> Settings</NavLink>
    </nav>

    <div class="ark-rail-foot">
        <div class="ark-system">
            <div class="ark-system-row">
                <Lamp Tone="@Presentation.Tone(_readiness.Phase)" />
                <strong>@Presentation.Label(_readiness.Phase)</strong>
            </div>
            @if (_maintenance.Phase != MaintenancePhase.None)
            {
                <div class="ark-system-row">
                    <Lamp Tone="st-transit" />
                    <span>@Presentation.Label(_maintenance.Phase)</span>
                </div>
                @if (_maintenance.Detail is { } detail)
                {
                    <div class="ark-system-detail">@detail</div>
                }
            }
            else
            {
                <div class="ark-system-detail">@Presentation.Plural(_live, "instance") up</div>
                @if (_maintenance.LastResult is { } result)
                {
                    <div class="ark-system-detail" title="@result.Summary">
                        @(result.BuildChanged ? $"Updated to build {result.InstalledBuild}" : result.InstalledBuild is null ? "Update checked" : $"Up to date, build {result.InstalledBuild}")
                        · @Presentation.Ago(result.CompletedAt, DateTimeOffset.UtcNow)
                    </div>
                }
            }
            <RadzenButton Text="Update game" Icon="system_update_alt" Size="ButtonSize.Small" Variant="Variant.Outlined" ButtonStyle="ButtonStyle.Base"
                          Disabled="@(!_readiness.IsReady)" Click="@(() => Navigation.NavigateTo("update"))" />
        </div>
        <AuthorizeView>
            <Authorized>
                <div class="ark-signout">
                    <form method="post" action="logout">
                        <AntiforgeryToken />
                        <button type="submit">Sign out</button>
                    </form>
                </div>
            </Authorized>
        </AuthorizeView>
        <div class="ark-version" title="Ark Ascended Server Admin @Host.Version">@Host.Version</div>
    </div>
</aside>

@code {
    private ReadinessState _readiness = default!;
    private MaintenanceSnapshot _maintenance = default!;
    private int _live;

    protected override void OnInitialized()
    {
        _readiness = Readiness.Current;
        _maintenance = Updates.Current;
        _live = CountLive();
        Readiness.Changed += OnReadiness;
        Updates.Changed += OnMaintenance;
        Processes.RuntimeChanged += OnRuntime;
    }

    private int CountLive() => Processes.GetAllRuntimes().Count(r => r.HasLiveProcess);

    private void OnReadiness(ReadinessState state) => _ = InvokeAsync(() => { _readiness = state; StateHasChanged(); });

    private void OnMaintenance(MaintenanceSnapshot snapshot) => _ = InvokeAsync(() =>
    {
        // The rail is on every page, so the end of an update is announced here regardless of where the owner is.
        var wasBusy = _maintenance.Phase != MaintenancePhase.None;
        _maintenance = snapshot;
        if (wasBusy && snapshot.Phase == MaintenancePhase.None)
        {
            if (snapshot.Detail is { } reason)
            {
                Notifications.Failed("Update stopped", reason);
            }
            else if (snapshot.LastResult is { } result)
            {
                Notifications.Done(result.BuildChanged ? "Game updated" : "Game is up to date", result.Summary);
            }
        }

        StateHasChanged();
    });

    private void OnRuntime(InstanceRuntime runtime) => _ = InvokeAsync(() => { _live = CountLive(); StateHasChanged(); });

    public void Dispose()
    {
        Readiness.Changed -= OnReadiness;
        Updates.Changed -= OnMaintenance;
        Processes.RuntimeChanged -= OnRuntime;
    }
}
