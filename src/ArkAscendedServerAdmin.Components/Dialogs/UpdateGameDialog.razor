@inject DialogService Dialogs

<div style="display:flex;flex-direction:column;gap:12px">
    @if (LiveCount > 0)
    {
        <p>@Presentation.Plural(LiveCount, "instance is", "instances are") running. Each gets the broadcast countdown, a world save, and a graceful stop before SteamCMD runs. They are started again afterwards.</p>
    }
    else
    {
        <p>SteamCMD checks for a new build and installs it into the shared game folder. Nothing is running, so no instance is affected.</p>
    }
    <p class="muted">Starts are refused while the update runs. Progress shows on the Instances page and in the rail.</p>
    <div class="form-actions" style="justify-content:flex-end;margin-top:6px">
        <RadzenButton Text="Cancel" Variant="Variant.Text" ButtonStyle="ButtonStyle.Base" Click="@(() => Dialogs.Close(false))" />
        <RadzenButton Text="@(LiveCount > 0 ? "Stop instances and update" : "Update now")" Icon="system_update_alt" ButtonStyle="@(LiveCount > 0 ? ButtonStyle.Warning : ButtonStyle.Primary)" Click="@(() => Dialogs.Close(true))" />
    </div>
</div>

@code {
    [Parameter]
    public int LiveCount { get; set; }
}
