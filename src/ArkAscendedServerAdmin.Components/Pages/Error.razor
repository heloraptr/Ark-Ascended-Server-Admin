@page "/Error"
@attribute [AllowAnonymous]
@using System.Diagnostics
@using Microsoft.AspNetCore.Http

<PageHead Title="Something went wrong" Lead="The request could not be completed. The service log has the details." />

@if (ShowRequestId)
{
    <p class="muted">Request id <code>@RequestId</code></p>
}
<RadzenButton Text="Back to instances" Variant="Variant.Outlined" ButtonStyle="ButtonStyle.Base" Click="@(() => Navigation.NavigateTo("", forceLoad: true))" />

@code {
    [Inject]
    private NavigationManager Navigation { get; set; } = default!;

    [CascadingParameter]
    private HttpContext? HttpContext { get; set; }

    private string? RequestId { get; set; }

    private bool ShowRequestId => !string.IsNullOrEmpty(RequestId);

    protected override void OnInitialized() =>
        RequestId = Activity.Current?.Id ?? HttpContext?.TraceIdentifier;
}
