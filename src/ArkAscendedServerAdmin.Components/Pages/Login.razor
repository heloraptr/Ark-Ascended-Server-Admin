@page "/login"
@layout LoginLayout
@attribute [AllowAnonymous]
@using System.ComponentModel.DataAnnotations
@using Microsoft.AspNetCore.Http
@inject ILoginService LoginService
@inject NavigationManager Navigation

<PageTitle>Sign in · Ark Ascended Server Admin</PageTitle>

<div class="ark-gate-card">
    <div class="ark-gate-brand" role="img" aria-label="ARK Ascended Server Administrator">
        <BrandMark />
        <span>
            <span class="ark-brand-name">ARK ASCENDED</span>
            <span class="ark-brand-sub">Server Administrator</span>
        </span>
    </div>
    <div class="ark-panel">
        <div class="horizon"></div>
        <div class="ark-panel-body">
            <EditForm Model="Input!" FormName="login" OnValidSubmit="SubmitAsync" method="post">
                <DataAnnotationsValidator />
                <div style="display:flex;flex-direction:column;gap:14px">
                    <h1 style="font-size:20px">Sign in</h1>
                    @if (_error is not null)
                    {
                        <Problems Items="@([_error])" />
                    }
                    <div class="field">
                        <label for="password">Password</label>
                        <InputText id="password" type="password" @bind-Value="Input!.Password" class="rz-textbox" autocomplete="current-password" autofocus />
                        <ValidationMessage For="() => Input!.Password" class="tone-bad" style="font-size:12.5px" />
                        <span class="hint">The one in appsettings.json on the server box. Five wrong tries lock this address out for five minutes.</span>
                    </div>
                    <RadzenButton ButtonType="ButtonType.Submit" Text="Sign in" Icon="login" ButtonStyle="ButtonStyle.Primary" Style="width:100%" />
                </div>
            </EditForm>
        </div>
    </div>
</div>

@code {
    private string? _error;

    [CascadingParameter]
    private HttpContext? HttpContext { get; set; }

    [SupplyParameterFromForm]
    private LoginInput? Input { get; set; }

    [SupplyParameterFromQuery(Name = "returnUrl")]
    private string? ReturnUrl { get; set; }

    protected override void OnInitialized()
    {
        Input ??= new LoginInput();
        if (HttpContext?.User.Identity is { IsAuthenticated: true })
        {
            Navigation.NavigateTo(SafeReturnUrl());
        }
    }

    private async Task SubmitAsync()
    {
        var result = await LoginService.LoginAsync(Input?.Password ?? string.Empty);
        if (result.Succeeded)
        {
            Navigation.NavigateTo(SafeReturnUrl());
            return;
        }

        _error = result.Message;
    }

    // Only same-origin relative paths are honored; anything else lands on the dashboard.
    private string SafeReturnUrl() =>
        ReturnUrl is not null && ReturnUrl.StartsWith('/') && !ReturnUrl.StartsWith("//", StringComparison.Ordinal) && !ReturnUrl.StartsWith("/\\", StringComparison.Ordinal)
            ? ReturnUrl
            : "/";

    private sealed class LoginInput
    {
        [Required(ErrorMessage = "Enter the password.")]
        public string? Password { get; set; }
    }
}
