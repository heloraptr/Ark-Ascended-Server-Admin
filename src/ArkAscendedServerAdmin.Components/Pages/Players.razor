@page "/players"
@inherits ArkPage
@implements IDisposable
@inject IPlayerCommands PlayerCommands
@inject IInstanceCommands Instances
@inject IClusterCommands Clusters
@inject IPlayerTracker Tracker
@inject IJSRuntime JS

<PageHead Title="Players" Lead="Everyone who has joined a server, recorded from the game log as it happens. Find an EOS id here and put it on a whitelist." />

@if (_players is null)
{
    <p class="muted">Loading…</p>
}
else if (_players.Count == 0)
{
    <EmptyState Title="No players yet.">
        A player appears here the moment they join a running server; nothing to press.
    </EmptyState>
}
else
{
    <p class="muted" style="margin:0 0 12px">
        @Presentation.Plural(_players.Count, "player") known, @(_players.Count(p => p.IsOnline)) online now.
    </p>
    <RadzenDataGrid Data="_players" TItem="KnownPlayer" Density="Density.Compact" AllowSorting="true" class="grid-clip">
        <Columns>
            <RadzenDataGridColumn TItem="KnownPlayer" Property="Name" Title="Name" Width="11%">
                <Template Context="p"><span class="clip" title="@p.Name">@p.Name</span></Template>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn TItem="KnownPlayer" Property="IsOnline" Title="Status" Width="12%">
                <Template Context="p">
                    <span class="clip" title="@Status(p)">
                        @if (p.IsOnline)
                        {
                            <span class="tone-ok">Online</span>
                            @if (p.LastInstance is { } on)
                            {
                                <span class="muted"> on @on.Name</span>
                            }
                        }
                        else
                        {
                            <span class="muted">Last seen @Presentation.Ago(p.LastSeenAt, _now)@(p.LastInstance is { } was ? $" on {was.Name}" : null)</span>
                        }
                    </span>
                </Template>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn TItem="KnownPlayer" Property="Platform" Title="Platform" Width="9%">
                <Template Context="p"><span class="clip muted" title="@p.Platform">@(p.Platform ?? "—")</span></Template>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn TItem="KnownPlayer" Property="EosId" Title="EOS id" Width="12%">
                <Template Context="p">
                    <div class="id-cell">
                        <span class="mono clip" title="@p.EosId">@p.EosId</span>
                        <RadzenButton Icon="content_copy" Size="ButtonSize.ExtraSmall" Variant="Variant.Text" ButtonStyle="ButtonStyle.Base" title="Copy id" Click="@(() => CopyAsync(p.EosId))" />
                    </div>
                </Template>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn TItem="KnownPlayer" Property="FirstSeenAt" Title="First seen" Width="14%">
                <Template Context="p"><span class="clip num" title="@Presentation.Stamp(p.FirstSeenAt)">@Presentation.Stamp(p.FirstSeenAt)</span></Template>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn TItem="KnownPlayer" Property="LastJoinedAt" Title="Last joined" Width="14%">
                <Template Context="p">
                    @{
                        var joined = p.LastJoinedAt is { } at ? Presentation.Stamp(at) : "—";
                    }
                    <span class="clip num" title="@joined">@joined</span>
                </Template>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn TItem="KnownPlayer" Title="Whitelist" Width="24%" Sortable="false">
                <Template Context="p">
                    <div class="wl-pick">
                        <RadzenDropDown TValue="string" @bind-Value="_target" Data="Targets" TextProperty="Text" ValueProperty="Value" Placeholder="Choose a list" Style="width:100%">
                            <Template Context="item">
                                @{
                                    var listed = (Target)item;
                                }
                                <span class="wl-target">
                                    <span class="clip" title="@listed.Text">@listed.Text</span>
                                    <span class="tag">@listed.Kind</span>
                                </span>
                            </Template>
                            <ValueTemplate Context="item">
                                @{
                                    var chosen = (Target)item;
                                }
                                <span class="wl-target">
                                    <span class="clip" title="@chosen.Text">@chosen.Text</span>
                                    <span class="tag">@chosen.Kind</span>
                                </span>
                            </ValueTemplate>
                        </RadzenDropDown>
                        <RadzenButton Text="Add" Size="ButtonSize.ExtraSmall" Variant="Variant.Outlined" ButtonStyle="ButtonStyle.Base" Disabled="@(Busy || _target is null)" Click="@(() => WhitelistAsync(p))" />
                    </div>
                </Template>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn TItem="KnownPlayer" Width="4%" Sortable="false">
                <Template Context="p">
                    <RadzenButton Icon="close" Size="ButtonSize.ExtraSmall" Variant="Variant.Text" ButtonStyle="ButtonStyle.Base" title="Forget" Click="@(() => ForgetAsync(p))" />
                </Template>
            </RadzenDataGridColumn>
        </Columns>
    </RadzenDataGrid>
    <p class="hint muted" style="margin-top:10px">Who is on a server right now is on that instance's Players tab. Forgetting a player only clears this row; they come back on their next join.</p>
}

@code {
    /// <summary>One entry of the whitelist drop-down: the name, the word for what it is, and "c"/"i" plus the id.</summary>
    private sealed record Target(string Text, string Kind, string Value);

    private IReadOnlyList<KnownPlayer>? _players;
    private IReadOnlyList<Target> Targets = [];
    private string? _target;
    private DateTimeOffset _now = DateTimeOffset.UtcNow;

    protected override async Task OnInitializedAsync()
    {
        Tracker.Changed += OnPlayersChanged;
        await GuardedAsync(async () =>
        {
            await LoadAsync();
            var dashboard = await Instances.GetDashboardAsync();
            Targets = dashboard.Clusters.Select(c => new Target(c.Name, "cluster", $"c{c.Id}"))
                .Concat(dashboard.Instances.Select(i => new Target(i.Name, "instance", $"i{i.Id}")))
                .ToList();
        });
    }

    /// <summary>The Status cell as one line, for the cell's title when the column cuts it off.</summary>
    private string Status(KnownPlayer player) => player.IsOnline
        ? $"Online{(player.LastInstance is { } on ? $" on {on.Name}" : null)}"
        : $"Last seen {Presentation.Ago(player.LastSeenAt, _now)}{(player.LastInstance is { } was ? $" on {was.Name}" : null)}";

    private async Task LoadAsync()
    {
        _players = await PlayerCommands.ListAsync();
        _now = DateTimeOffset.UtcNow;
    }

    /// <summary>A join or leave landed in the table; the page follows it without a reload.</summary>
    private void OnPlayersChanged() => _ = InvokeAsync(async () =>
    {
        await GuardedAsync(LoadAsync);
        StateHasChanged();
    });

    private async Task CopyAsync(string text)
    {
        var copied = await JS.InvokeAsync<bool>("ark.copyText", text);
        Notifications.Info(copied ? "Copied" : "Copy failed", copied ? text : "The browser refused clipboard access.");
    }

    private async Task WhitelistAsync(KnownPlayer player)
    {
        if (_target is null)
        {
            return;
        }

        var id = int.Parse(_target[1..], System.Globalization.CultureInfo.InvariantCulture);
        await GuardedAsync(async () =>
        {
            if (_target.StartsWith('c'))
            {
                var cluster = await Clusters.GetAsync(id);
                if (cluster is null)
                {
                    return;
                }

                var result = await Clusters.SaveAsync(id, new ClusterEdit(cluster.Cluster.Name, cluster.Cluster.ClusterKey, Append(cluster.Cluster.AdminWhitelist, player.EosId)));
                Notifications.Report(result, ActionVerb.AddedTo, $"{cluster.Cluster.Name}'s whitelist");
            }
            else
            {
                var detail = await Instances.GetAsync(id);
                if (detail is null)
                {
                    return;
                }

                var i = detail.Instance;
                var result = await Instances.SaveAsync(id, new InstanceEdit(i.Name, i.SessionName, i.MaxPlayers, i.GamePort, i.RconPort, Append(i.AdminWhitelist, player.EosId), i.BackupIntervalMinutes, i.BackupRetention, i.OverridesClusterSchedule));
                Notifications.Report(result, ActionVerb.AddedTo, $"{i.Name}'s whitelist");
            }
        });
    }

    private static string Append(string whitelist, string eosId)
    {
        var lines = whitelist.Split(['\r', '\n'], StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries).ToList();
        if (!lines.Contains(eosId, StringComparer.OrdinalIgnoreCase))
        {
            lines.Add(eosId);
        }

        return string.Join("\r\n", lines);
    }

    private async Task ForgetAsync(KnownPlayer player)
    {
        await GuardedAsync(async () =>
        {
            await PlayerCommands.DeleteAsync(player.Id);
            await LoadAsync();
            Notifications.Done($"Forgot {player.Name}");
        });
    }

    public void Dispose() => Tracker.Changed -= OnPlayersChanged;
}
