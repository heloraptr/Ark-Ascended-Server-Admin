@page "/setup"
@implements IDisposable
@inject IReadinessMonitor Readiness
@inject IMaintenanceCommands Maintenance
@inject NavigationManager Navigation

<PageTitle>Setup · Ark Ascended Server Admin</PageTitle>

<RadzenText TextStyle="TextStyle.H4" TagName="TagName.H1">Setup</RadzenText>

<RadzenCard>
    <RadzenStack Gap="0.75rem">
        <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.75rem">
            <RadzenBadge BadgeStyle="@BadgeStyle(_state.Phase)" Text="@_state.Phase.ToString()" />
            <RadzenText TextStyle="TextStyle.Body1" class="rz-m-0">@_state.Message</RadzenText>
            @if (_state.Phase is ReadinessPhase.Initializing or ReadinessPhase.Recovering or ReadinessPhase.Installing)
            {
                <RadzenProgressBarCircular ProgressBarStyle="ProgressBarStyle.Primary" Mode="ProgressBarMode.Indeterminate" Size="ProgressBarCircularSize.Small" ShowValue="false" />
            }
        </RadzenStack>

        @if (_state.Error is not null)
        {
            <RadzenAlert AlertStyle="AlertStyle.Danger" Variant="Variant.Flat" AllowClose="false">@_state.Error</RadzenAlert>
        }

        @if (_actionError is not null)
        {
            <RadzenAlert AlertStyle="AlertStyle.Warning" Variant="Variant.Flat" AllowClose="true" Close="@(() => _actionError = null)">@_actionError</RadzenAlert>
        }

        @if (_state.CanRetryInstall)
        {
            <div>
                <RadzenButton Text="Retry install" Icon="refresh" Click="RetryAsync" Disabled="_busy" />
            </div>
        }

        <RadzenText TextStyle="TextStyle.Caption">
            Last change @_state.ChangedAt.ToLocalTime().ToString("HH:mm:ss"). The install console arrives with the SteamCMD runner.
        </RadzenText>
    </RadzenStack>
</RadzenCard>

@code {
    private ReadinessState _state = default!;
    private string? _actionError;
    private bool _busy;

    protected override void OnInitialized()
    {
        _state = Readiness.Current;
        Readiness.Changed += OnChanged;
        RedirectIfReady();
    }

    private void OnChanged(ReadinessState state) =>
        _ = InvokeAsync(() =>
        {
            _state = state;
            RedirectIfReady();
            StateHasChanged();
        });

    private void RedirectIfReady()
    {
        if (_state.IsReady)
        {
            Navigation.NavigateTo("/");
        }
    }

    private async Task RetryAsync()
    {
        _busy = true;
        _actionError = null;
        try
        {
            await Maintenance.RetryInstallAsync();
        }
        catch (NotAuthorizedException ex)
        {
            _actionError = ex.Message;
        }
        finally
        {
            _busy = false;
        }
    }

    private static BadgeStyle BadgeStyle(ReadinessPhase phase) => phase switch
    {
        ReadinessPhase.Ready => Radzen.BadgeStyle.Success,
        ReadinessPhase.InstallFailed or ReadinessPhase.Failed => Radzen.BadgeStyle.Danger,
        ReadinessPhase.Installing => Radzen.BadgeStyle.Warning,
        _ => Radzen.BadgeStyle.Info,
    };

    public void Dispose() => Readiness.Changed -= OnChanged;
}
