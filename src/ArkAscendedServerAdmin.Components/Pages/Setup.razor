@page "/setup"
@inherits ArkPage
@implements IDisposable
@inject IReadinessMonitor Readiness
@inject ISteamCmdProgressMonitor Progress
@inject IMaintenanceCommands Maintenance

<PageHead Title="Setup" Lead="The service gets ready in the background: database, surviving processes, then the game install." />

<div class="ark-panel" style="margin-bottom:20px">
    <div class="ark-panel-body" style="display:flex;flex-direction:column;gap:10px">
        <div class="state @Presentation.Tone(_state.Phase)" style="font-size:15px">
            <Lamp Tone="@Presentation.Tone(_state.Phase)" />
            <span>@Presentation.Label(_state.Phase)</span>
            <span class="faint" style="font-size:12.5px;margin-left:8px">since @Presentation.Clock(_state.ChangedAt)</span>
        </div>
        <p style="margin:0;max-width:none">@_state.Message</p>
        @if (_progress is { } progress)
        {
            <div>
                <RadzenProgressBar Value="@Math.Round(progress.Percent, 1)" ShowValue="true" Style="height:8px" />
                <span class="hint muted">@progress.State · @Presentation.Bytes(progress.Done) of @Presentation.Bytes(progress.Total)</span>
            </div>
        }
        @if (_state.Error is not null)
        {
            <Problems Items="@([_state.Error])" />
        }
        @if (_state.CanRetryInstall)
        {
            <div>
                <RadzenButton Text="Retry install" Icon="refresh" ButtonStyle="ButtonStyle.Primary" Disabled="Busy" Click="RetryAsync" />
                <span class="hint muted" style="margin-left:10px">SteamCMD retried five times with backoff before giving up. Anonymous Steam downloads are sometimes throttled; trying again later usually works.</span>
            </div>
        }
        @if (_state.Phase == ReadinessPhase.Failed)
        {
            <p class="hint muted" style="margin:0">Only a service restart clears a failed pipeline step. The service log has the stack trace.</p>
        }
    </div>
</div>

<ConsolePanel Channel="@ConsoleChannels.SteamCmd" Title="SteamCMD" Height="calc(100vh - 360px)" EmptyText="SteamCMD has not printed anything yet. The first run downloads SteamCMD itself, updates it, and then fetches roughly 12 GB." />

@code {
    private ReadinessState _state = default!;
    private SteamCmdProgress? _progress;

    protected override void OnInitialized()
    {
        _state = Readiness.Current;
        _progress = Progress.Current;
        Readiness.Changed += OnChanged;
        Progress.Changed += OnProgress;
        RedirectIfReady();
    }

    private void OnChanged(ReadinessState state) => _ = InvokeAsync(() =>
    {
        _state = state;
        RedirectIfReady();
        StateHasChanged();
    });

    private void OnProgress(SteamCmdProgress? progress) => _ = InvokeAsync(() =>
    {
        _progress = progress;
        StateHasChanged();
    });

    private void RedirectIfReady()
    {
        if (_state.IsReady)
        {
            Navigation.NavigateTo("/");
        }
    }

    private async Task RetryAsync()
    {
        await GuardedAsync(async () =>
        {
            await Maintenance.RetryInstallAsync();
            Notifications.Info("Install restarted");
        });
    }

    public void Dispose()
    {
        Readiness.Changed -= OnChanged;
        Progress.Changed -= OnProgress;
    }
}
