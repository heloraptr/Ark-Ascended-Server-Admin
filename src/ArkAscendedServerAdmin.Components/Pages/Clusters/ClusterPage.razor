@page "/clusters/{Id:int}"
@inherits ArkPage
@implements IDisposable
@inject IClusterCommands ClusterCommands
@inject IModCommands ModCommands
@inject IProcessManager Processes
@inject IBackupService BackupService

@if (_detail is null)
{
    <PageHead Title="@(_missing ? "Cluster not found" : "Loading…")" />
    @if (_missing)
    {
        <EmptyState Title="There is no cluster with this id.">
            <Actions><RadzenButton Text="Back to clusters" Variant="Variant.Outlined" ButtonStyle="ButtonStyle.Base" Click="@(() => Navigation.NavigateTo("clusters"))" /></Actions>
        </EmptyState>
    }
}
else
{
    var cluster = _detail.Cluster;
    <PageHead Title="@cluster.Name">
        <Crumb><a href="clusters">Clusters</a></Crumb>
        <LeadContent>
            cluster id <span class="mono">@cluster.ClusterKey</span>
            <span class="faint"> · </span>@Presentation.Plural(_detail.Instances.Count, "member")
            <span class="faint"> · </span>@Presentation.Plural(_detail.Mods.Count(m => m.Enabled), "mod")
        </LeadContent>
        <Actions>
            <RadzenButton Text="New instance" Icon="add" ButtonStyle="ButtonStyle.Primary" Click="@(() => Navigation.NavigateTo($"instances/new?cluster={Id}"))" />
            <RadzenButton Text="Start all" Icon="play_arrow" ButtonStyle="ButtonStyle.Success" Variant="Variant.Outlined" Disabled="@(!_detail.Instances.Any(i => !Processes.GetRuntime(i.Id).HasLiveProcess))" Click="@(() => FireMany(() => InstanceCommands.StartManyAsync(_detail.Instances.Where(i => !Processes.GetRuntime(i.Id).HasLiveProcess).Select(i => i.Id).ToList()), "Started"))" />
            <RadzenButton Text="Stop all" Icon="stop" ButtonStyle="ButtonStyle.Danger" Variant="Variant.Outlined" Disabled="@(!_detail.Instances.Any(i => Processes.GetRuntime(i.Id).HasLiveProcess))" Click="@(() => FireMany(() => InstanceCommands.StopManyAsync(_detail.Instances.Where(i => Processes.GetRuntime(i.Id).HasLiveProcess).Select(i => i.Id).ToList()), "Stopped"))" />
            <RadzenButton Icon="delete" ButtonStyle="ButtonStyle.Danger" Variant="Variant.Text" title="Delete cluster" Disabled="@(_detail.Instances.Count > 0)" Click="DeleteAsync" />
        </Actions>
    </PageHead>

    @if (_detail.Instances.Any(i => Processes.GetRuntime(i.Id).HasLiveProcess))
    {
        <Notice Tone="is-info">
            <p>Members are running. INI, mod, and launch changes apply to each member at its next start.</p>
        </Notice>
    }
    @if (_journal is { } journal)
    {
        var target = _detail.Instances.FirstOrDefault(i => i.Id == journal.InstanceId)?.Name ?? journal.InstanceSlug;
        <Notice Tone="is-bad" Title="Incomplete restore.">
            <ChildContent>
                <p>A restore of <a href="instances/@journal.InstanceId">@target</a> from <span class="mono">@journal.SourceFileName</span> that included the cluster directory stopped while @Presentation.Label(journal.Phase). Starting any member, adding one, and deleting the cluster are refused until it is resolved. <strong>Recover from safety copy</strong> puts the files from before the restore back from <span class="mono">@journal.SafetyCopyPath</span>; <strong>Discard journal</strong> only removes the record.</p>
            </ChildContent>
            <Actions>
                <RadzenButton Text="Recover from safety copy" Icon="settings_backup_restore" Size="ButtonSize.Small" Variant="Variant.Outlined" ButtonStyle="ButtonStyle.Base" Click="@(() => Fire(() => InstanceCommands.RecoverRestoreAsync(journal.OperationId), ActionVerb.Recovered, target, () => _ = LoadAsync()))" />
                <RadzenButton Text="Discard journal" Icon="delete_sweep" Size="ButtonSize.Small" Variant="Variant.Text" ButtonStyle="ButtonStyle.Danger" Click="@(() => DiscardJournalAsync(journal))" />
            </Actions>
        </Notice>
    }

    <RadzenTabs RenderMode="TabRenderMode.Client">
        <Tabs>
            <RadzenTabsItem Text="Members">
                @if (_detail.Instances.Count == 0)
                {
                    <EmptyState Title="No members yet.">
                        <ChildContent>Create an instance and choose this cluster in the wizard.</ChildContent>
                        <Actions><RadzenButton Text="New instance" Icon="add" ButtonStyle="ButtonStyle.Primary" Click="@(() => Navigation.NavigateTo($"instances/new?cluster={Id}"))" /></Actions>
                    </EmptyState>
                }
                else
                {
                    <div class="ark-rows">
                        @foreach (var instance in _detail.Instances)
                        {
                            var runtime = Processes.GetRuntime(instance.Id);
                            <div class="ark-row" style="grid-template-columns: 22px minmax(180px,1.4fr) minmax(120px,1fr) 150px 170px auto">
                                <Lamp Tone="@Presentation.Tone(runtime.State)" Hollow="@Presentation.IsHollow(runtime.State)" />
                                <div class="name"><a href="instances/@instance.Id">@instance.Name</a><small>@instance.SessionName</small></div>
                                <div class="cell"><strong>@instance.MapName</strong></div>
                                <div class="cell ports"><strong class="num">@instance.GamePort <span class="faint">game</span></strong><span class="num">@instance.RconPort <span class="faint">rcon</span></span></div>
                                <div class="cell">
                                    <InstanceStateView Runtime="runtime" ShowHint="false" />
                                    @if (instance.NextDeadline is { } deadline)
                                    {
                                        <span style="display:block;font-size:12px" title="@Presentation.Stamp(deadline)"><span class="faint">Next action</span> <span class="muted">@Presentation.Until(deadline, _now)</span></span>
                                    }
                                </div>
                                <div class="actions">
                                    <RadzenButton Icon="arrow_forward" Size="ButtonSize.Small" Variant="Variant.Text" ButtonStyle="ButtonStyle.Base" title="Open" Click="@(() => Navigation.NavigateTo($"instances/{instance.Id}"))" />
                                </div>
                            </div>
                        }
                    </div>
                }
            </RadzenTabsItem>

            <RadzenTabsItem Text="Config">
                <RadzenTabs RenderMode="TabRenderMode.Client">
                    <Tabs>
                        <RadzenTabsItem Text="GameUserSettings.ini">
                            <IniEditor Owner="@IniOwner.ForCluster(Id)" File="IniFile.GameUserSettings" />
                        </RadzenTabsItem>
                        <RadzenTabsItem Text="Game.ini">
                            <IniEditor Owner="@IniOwner.ForCluster(Id)" File="IniFile.Game" />
                        </RadzenTabsItem>
                    </Tabs>
                </RadzenTabs>
            </RadzenTabsItem>

            <RadzenTabsItem Text="Mods">
                <p class="muted">Mandatory for every member and loaded before each member's own mods. A custom map's own mod loads ahead of these on that member alone and is not listed here.</p>
                <ModListEditor Mods="_detail.Mods" Library="_library" Busy="Busy" OnSave="SaveModsAsync" />
            </RadzenTabsItem>

            <RadzenTabsItem Text="Launch">
                <p class="muted">The base every member starts from; a member can override each flag.</p>
                <LaunchFlagsEditor Flags="cluster.LaunchFlags" Busy="Busy" OnSave="SaveLaunchFlagsAsync" />
            </RadzenTabsItem>

            <RadzenTabsItem Text="Settings">
                <div class="form-grid">
                    <div class="field">
                        <label for="c-name">Cluster name</label>
                        <RadzenTextBox id="c-name" @bind-Value="_name" />
                        <span class="hint">The folder stays <code>Clusters\@cluster.Slug</code>.</span>
                    </div>
                    <div class="field">
                        <label for="c-key">Cluster id</label>
                        <RadzenTextBox id="c-key" @bind-Value="_key" />
                        <span class="hint">Passed as -clusterid; every member must share it for transfers to work. Changing it strands existing transfers.</span>
                    </div>
                    <div class="field span-2">
                        <label>Admin whitelist</label>
                        <WhitelistEditor @bind-Value="_whitelist" />
                        <span class="hint">Merged with the Settings list and each member's own list at start.</span>
                    </div>
                </div>
                <Problems Items="_problems" />
                <div class="form-actions">
                    <RadzenButton Text="Save settings" Icon="save" ButtonStyle="ButtonStyle.Primary" Disabled="Busy" Click="SaveAsync" />
                    <RadzenButton Text="Reset" Variant="Variant.Text" ButtonStyle="ButtonStyle.Base" Disabled="Busy" Click="ResetEdit" />
                </div>
                <section class="ark-section" style="margin-top:28px">
                    <SectionHead Title="Schedule" />
                    <p class="muted">Every member runs these unless it ignores the cluster's schedule on its Settings tab.</p>
                    @if (_schedule is null)
                    {
                        <p class="muted">Loading…</p>
                    }
                    else
                    {
                        <ScheduleEditor Rows="_schedule" Runs="_scheduleRuns" ShowInstanceColumn="true" Busy="Busy" OnSave="SaveScheduleAsync" />
                    }
                </section>
            </RadzenTabsItem>
        </Tabs>
    </RadzenTabs>
}

@code {
    [Inject]
    private IInstanceCommands InstanceCommands { get; set; } = default!;

    private ClusterDetail? _detail;
    private RestoreJournal? _journal;
    private IReadOnlyList<ScheduledActionView>? _schedule;
    private IReadOnlyList<ScheduledActionRunView> _scheduleRuns = [];
    private DateTimeOffset _now = DateTimeOffset.UtcNow;
    private IReadOnlyList<ModLibraryEntry> _library = [];
    private string? _name;
    private string? _key;
    private string _whitelist = string.Empty;
    private IReadOnlyList<string>? _problems;
    private bool _missing;
    private int _loadedId;

    [Parameter]
    public int Id { get; set; }

    protected override void OnInitialized()
    {
        Processes.RuntimeChanged += OnRuntimeChanged;
        BackupService.Restored += OnRestored;
    }

    /// <summary>A member restore or recovery resolves or leaves a journal; the banner follows without a reload.</summary>
    private void OnRestored(RestoreRecord record) => _ = InvokeAsync(async () =>
    {
        await GuardedAsync(async () => _journal = await ClusterCommands.GetRestoreJournalAsync(Id));
        StateHasChanged();
    });

    protected override async Task OnParametersSetAsync()
    {
        if (_loadedId == Id)
        {
            return;
        }

        _loadedId = Id;
        await LoadAsync();
    }

    private Task LoadAsync() => GuardedAsync(async () =>
    {
        _detail = await ClusterCommands.GetAsync(Id);
        _missing = _detail is null;
        _journal = await ClusterCommands.GetRestoreJournalAsync(Id);
        if (_detail is null)
        {
            return;
        }

        var mapMods = await ModCommands.GetMapModsAsync();
        _library = (await ModCommands.ListLibraryAsync()).Where(m => !mapMods.ContainsKey(m.Id)).ToList();
        ResetEdit();
        _now = DateTimeOffset.UtcNow;
        await LoadScheduleAsync();
    });

    private void ResetEdit()
    {
        _name = _detail!.Cluster.Name;
        _key = _detail.Cluster.ClusterKey;
        _whitelist = _detail.Cluster.AdminWhitelist;
        _problems = null;
    }

    private void OnRuntimeChanged(InstanceRuntime runtime) => _ = InvokeAsync(StateHasChanged);

    private async Task SaveAsync()
    {
        await GuardedAsync(async () =>
        {
            var result = await ClusterCommands.SaveAsync(Id, new ClusterEdit(_name ?? string.Empty, _key ?? string.Empty, _whitelist ?? string.Empty));
            _problems = result.Succeeded ? null : result.Errors;
            if (result.Succeeded)
            {
                Notifications.Done("Saved settings");
                _detail = await ClusterCommands.GetAsync(Id);
                ResetEdit();
            }
        });
    }

    private async Task SaveLaunchFlagsAsync(LaunchFlags flags)
    {
        await GuardedAsync(async () =>
        {
            var result = await ClusterCommands.SaveLaunchFlagsAsync(Id, flags);
            Notifications.Report(result, ActionVerb.Saved, "launch options");
            if (result.Succeeded)
            {
                _detail = await ClusterCommands.GetAsync(Id);
            }
        });
    }

    private async Task LoadScheduleAsync()
    {
        var rows = await ClusterCommands.ListScheduledActionsAsync(Id);
        var runs = await ClusterCommands.ListScheduledActionRunsAsync(Id);
        _schedule = rows.Value ?? [];
        _scheduleRuns = runs.Value ?? [];
    }

    /// <summary>The editor shows a refused save's problems itself; a successful save reloads the rows so the new ids and the runs follow.</summary>
    private async Task<CommandResult> SaveScheduleAsync(IReadOnlyList<ScheduledActionEdit> rows)
    {
        var result = CommandResult.Fail("The schedule was not saved.");
        await GuardedAsync(async () =>
        {
            result = await ClusterCommands.SaveScheduledActionsAsync(Id, rows);
            if (result.Succeeded)
            {
                Notifications.Done("Saved schedule");
                await LoadScheduleAsync();
            }
        });
        return result;
    }

    private async Task SaveModsAsync(IReadOnlyList<ModSelection> mods)
    {
        await GuardedAsync(async () =>
        {
            var result = await ClusterCommands.SetModsAsync(Id, mods);
            Notifications.Report(result, ActionVerb.Saved, "cluster mods");
            if (result.Succeeded)
            {
                _detail = await ClusterCommands.GetAsync(Id);
            }
        });
    }

    private async Task DiscardJournalAsync(RestoreJournal journal)
    {
        var confirmed = await ConfirmAsync(
            "Discard the restore journal",
            $"The record of restore {journal.OperationId} is removed and the files are left exactly as they are; the safety copy at {journal.SafetyCopyPath} stays until it is pruned. Do this only after checking the world and cluster folders by hand.",
            "Discard journal",
            danger: true,
            icon: "delete_sweep");
        if (confirmed)
        {
            Fire(() => InstanceCommands.DiscardRestoreJournalAsync(journal.OperationId), ActionVerb.Discarded, "the restore journal", () => _ = LoadAsync());
        }
    }

    private async Task DeleteAsync()
    {
        var name = _detail!.Cluster.Name;
        if (!await ConfirmAsync($"Delete {name}", "The cluster row, its mod list, and its INI mirror rows are removed. The folder under Clusters stays on disk.", "Delete cluster", danger: true))
        {
            return;
        }

        await GuardedAsync(async () =>
        {
            var result = await ClusterCommands.DeleteAsync(Id);
            Notifications.Report(result, ActionVerb.Deleted, name);
            if (result.Succeeded)
            {
                Navigation.NavigateTo("clusters");
            }
        });
    }

    public void Dispose()
    {
        Processes.RuntimeChanged -= OnRuntimeChanged;
        BackupService.Restored -= OnRestored;
    }
}
