@* Source INI editor (plan step 16): optimistic concurrency on the SHA-256, reserved-key warnings, mirror retry. *@
@using ArkAscendedServerAdmin.Ini
@implements IAsyncDisposable
@inject IConfigCommands Config
@inject NotificationService Notifications
@inject NavigationManager Navigation
@inject IJSRuntime JS

<div class="ini-editor">
    @if (_document is null)
    {
        <p class="muted">Loading @FileName…</p>
    }
    else
    {
        @if (_conflict)
        {
            <Notice Tone="is-warn" Title="Changed on disk since you opened it.">
                <ChildContent><p>Reload to see the current text; your edits here will be lost.</p></ChildContent>
                <Actions>
                    <RadzenButton Text="Reload" Icon="refresh" Size="ButtonSize.Small" Variant="Variant.Outlined" ButtonStyle="ButtonStyle.Base" Click="ReloadAsync" />
                </Actions>
            </Notice>
        }
        @if (_mirrorStale)
        {
            <Notice Tone="is-warn" Title="The database copy of this file is behind the file on disk.">
                <ChildContent><p>The file is what the game gets; the database copy only exists so a config backup is complete.</p></ChildContent>
                <Actions>
                    <RadzenButton Text="Retry mirror" Icon="sync" Size="ButtonSize.Small" Variant="Variant.Outlined" ButtonStyle="ButtonStyle.Base" Disabled="_busy" Click="RetryMirrorAsync" />
                </Actions>
            </Notice>
        }
        @if (_reserved.Count > 0)
        {
            <Notice Tone="is-info" Title="Manager-owned keys in this file are replaced when the instance starts.">
                <ul>
                    @foreach (var hit in _reserved)
                    {
                        <li>Line @hit.LineNumber: <code>@hit.Key</code> in <code>[@hit.Section]</code></li>
                    }
                </ul>
            </Notice>
        }
        @if (_passwordMissing)
        {
            <Notice Tone="is-warn" Title="ServerAdminPassword is empty.">
                <p>Set it under <code>[ServerSettings]</code>. RCON is the only way the manager saves and stops the server, so Start is refused until it has a value.</p>
            </Notice>
        }

        <div class="ini-bar">
            <span>@FileName</span>
            <span class="faint">saved @Presentation.Ago(_document.UpdatedAt, DateTimeOffset.UtcNow)</span>
            @if (_dirty)
            {
                <span class="dirty">unsaved changes</span>
            }
            <span class="spacer"></span>
            <RadzenButton Text="Reload" Icon="refresh" Size="ButtonSize.Small" Variant="Variant.Text" ButtonStyle="ButtonStyle.Base" Disabled="_busy" Click="ReloadAsync" />
            <RadzenButton Text="@($"Save {FileName}")" Icon="save" title="Save (Ctrl+S while editing)" Size="ButtonSize.Small" ButtonStyle="ButtonStyle.Primary" Disabled="@(_busy || !_dirty || _conflict)" Click="SaveAsync" />
        </div>
        <textarea @ref="_textarea" data-generation="@_generation" @bind="_text" @bind:event="oninput" @bind:after="OnTextChanged" spellcheck="false" wrap="off" aria-label="@FileName"></textarea>
    }
</div>

@code {
    private IniSourceDocument? _document;
    private string _text = string.Empty;
    private bool _dirty;
    private bool _busy;
    private bool _conflict;
    private bool _mirrorStale;
    private bool _passwordMissing;
    private IReadOnlyList<IniReservedKeyHit> _reserved = [];
    private (IniOwner Owner, IniFile File)? _loaded;
    private ElementReference _textarea;
    private DotNetObjectReference<IniEditor>? _self;
    private string? _shortcutBoundTo;
    private int _generation; // bumped by every load, so a save that outlives it leaves the new document alone

    [Parameter, EditorRequired]
    public IniOwner Owner { get; set; } = default!;

    [Parameter, EditorRequired]
    public IniFile File { get; set; }

    [Parameter]
    public EventCallback OnSaved { get; set; }

    private string FileName => File == IniFile.Game ? "Game.ini" : "GameUserSettings.ini";

    public bool IsDirty => _dirty;

    protected override async Task OnParametersSetAsync()
    {
        if (_loaded is { } loaded && loaded.Owner == Owner && loaded.File == File)
        {
            return;
        }

        _loaded = (Owner, File);
        await ReloadAsync();
    }

    private async Task ReloadAsync()
    {
        _busy = true;
        _generation++;
        await Navigation.GuardedAsync(async () =>
        {
            _document = await Config.LoadIniAsync(Owner, File);
            _text = _document.Text;
            _dirty = false;
            _conflict = false;
            _mirrorStale = _document.MirrorStale;
            Analyze();
        }, Notifications);
        _busy = false;
    }

    private void OnTextChanged()
    {
        // The text area reports LF whatever the file uses; the save puts the file's own endings back.
        _dirty = _document is not null && !IniLineEndings.Equivalent(_text, _document.Text);
        Analyze();
    }

    private void Analyze()
    {
        _reserved = IniReservedKeyScanner.Find(_text);
        _passwordMissing = File == IniFile.GameUserSettings && string.IsNullOrWhiteSpace(IniText.Parse(_text).Get(IniGenerator.ServerSettingsSection, "ServerAdminPassword"));
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        // Ctrl+S is bound to this textarea only: both editors are in the page at once, and each saves its own file.
        if (_document is null || _textarea.Id is not { } id || id == _shortcutBoundTo)
        {
            return;
        }

        try
        {
            _self ??= DotNetObjectReference.Create(this);
            await JS.InvokeVoidAsync("ark.bindSaveShortcut", _textarea, _self);
            _shortcutBoundTo = id;
        }
        catch (JSDisconnectedException)
        {
        }
    }

    /// <summary>Ctrl+S in the textarea. The browser's save dialog is already suppressed; this saves when the button would.</summary>
    [JSInvokable]
    public async Task SaveFromShortcut(string text, int generation)
    {
        if (_document is null || _busy || generation != _generation)
        {
            return;
        }

        // The browser reports the value with LF line ends, so only a difference beyond those means an input event is
        // still on its way; adopting the value otherwise would turn a CRLF file dirty without a keystroke.
        if (!IniLineEndings.Equivalent(text, _text))
        {
            _text = text;
            OnTextChanged();
        }

        if (_dirty && !_conflict)
        {
            await SaveAsync();
        }

        StateHasChanged();
    }

    private async Task SaveAsync()
    {
        if (_document is not { } document || _busy)
        {
            return;
        }

        // Typing goes on while the save is in flight: what was sent is what becomes the saved document, and the
        // editor is dirty again if the text moved on meanwhile.
        var (owner, file, generation, text, fileName) = (Owner, File, _generation, _text, FileName);
        _busy = true;
        await Navigation.GuardedAsync(async () =>
        {
            var result = await Config.SaveIniAsync(owner, file, text, document.Sha256);
            var current = generation == _generation; // false when a load (another file, or a reload) happened meanwhile
            if (!result.Succeeded)
            {
                _conflict |= current;
                Notifications.Failed($"Could not save {fileName}", result.Error);
                return;
            }

            if (current)
            {
                _document = document with { Text = result.WrittenText ?? text, Sha256 = result.NewSha256!, UpdatedAt = DateTimeOffset.UtcNow, MirrorStale = result.MirrorFailed };
                _dirty = !IniLineEndings.Equivalent(_text, text);
                _mirrorStale = result.MirrorFailed;
            }

            if (result.MirrorFailed)
            {
                Notifications.Warn($"Saved {fileName}", "The file was written, but the database copy could not be updated.");
            }
            else
            {
                Notifications.Done($"Saved {fileName}");
            }

            await OnSaved.InvokeAsync();
        }, Notifications);
        if (generation == _generation)
        {
            _busy = false; // otherwise the load that superseded this save owns the flag
        }
    }

    private async Task RetryMirrorAsync()
    {
        _busy = true;
        await Navigation.GuardedAsync(async () =>
        {
            var result = await Config.RetryMirrorAsync(Owner, File);
            _mirrorStale = !result.Succeeded || result.MirrorFailed;
            if (_mirrorStale)
            {
                Notifications.Failed("Mirror still behind", result.Error ?? "The database write failed again.");
            }
            else
            {
                Notifications.Done("Mirror updated");
            }
        }, Notifications);
        _busy = false;
    }

    public async ValueTask DisposeAsync()
    {
        if (_shortcutBoundTo is not null)
        {
            try
            {
                await JS.InvokeVoidAsync("ark.releaseKeys", _textarea);
            }
            catch (JSDisconnectedException)
            {
            }
        }

        _self?.Dispose();
    }
}
