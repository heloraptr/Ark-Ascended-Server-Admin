@* Shared console (plan step 32): one channel of IConsoleService, live-followed, with an optional command line. *@
@implements IAsyncDisposable
@inject IConsoleService Console
@inject IJSRuntime JS

<div class="console" style="@(Height is null ? null : $"height:{Height}")">
    <div class="console-bar">
        <span>@Title</span>
        @if (_hasBackfill)
        {
            <span class="tag is-trace" title="Lines above were read from ShooterGame.log after the service re-attached to the running process.">re-attached, log history</span>
        }
        @if (_lines.Count > Visible)
        {
            <span class="tag">last @Visible of @_lines.Count lines</span>
        }
        <span class="spacer"></span>
        <RadzenButton Text="@(_follow ? "Following" : "Follow")" Icon="@(_follow ? "vertical_align_bottom" : "pause")" Size="ButtonSize.ExtraSmall" Variant="Variant.Text" ButtonStyle="@(_follow ? ButtonStyle.Primary : ButtonStyle.Base)" Click="ToggleFollow" />
        <RadzenButton Icon="content_copy" Size="ButtonSize.ExtraSmall" Variant="Variant.Text" ButtonStyle="ButtonStyle.Base" title="Copy visible lines" Click="CopyAsync" />
        <RadzenButton Icon="backspace" Size="ButtonSize.ExtraSmall" Variant="Variant.Text" ButtonStyle="ButtonStyle.Base" title="Clear this view (the log itself is untouched)" Click="ClearView" />
    </div>
    <div class="console-out" @ref="_output" tabindex="0" aria-live="polite" aria-label="@Title">
        @if (_lines.Count == 0)
        {
            <span class="console-empty">@EmptyText</span>
        }
        else
        {
            @foreach (var line in _lines.Skip(Math.Max(0, _lines.Count - Visible)))
            {
                <span class="console-line k-@line.Kind.ToString().ToLowerInvariant()">@if (!line.Text.StartsWith('[')) { <span class="t">@Presentation.Clock(line.At)</span> }@line.Text</span>
            }
        }
    </div>
    @if (OnCommand.HasDelegate)
    {
        var items = _input.Items;
        var listOpen = items.Count > 0;
        <div class="console-in">
            @if (listOpen)
            {
                string? group = null;
                <div class="console-suggest" id="@_listId" role="listbox" aria-label="RCON commands" @onmousedown:preventDefault="true">
                    @for (var i = 0; i < items.Count; i++)
                    {
                        var index = i;
                        var command = items[i];
                        if (_input.IsBrowsing && command.Group != group)
                        {
                            group = command.Group;
                            <div class="console-suggest-group">@group</div>
                        }

                        <div id="@($"{_listId}-{index}")" class="console-suggest-item@(index == _input.Highlight ? " is-active" : null)" role="option"
                             aria-selected="@(index == _input.Highlight ? "true" : "false")" @onclick="() => AcceptAsync(command)">
                            <span class="name">@command.Name</span><span class="syntax">@command.Syntax</span>
                            <span class="desc">@command.Description</span>
                            @if (command.Note is { } note)
                            {
                                <span class="note"><i class="rzi" aria-hidden="true">warning</i>@note</span>
                            }
                        </div>
                    }
                </div>
            }
            else if (_input.Hint is { } hint)
            {
                <div class="console-hint">
                    <div class="line"><span class="name">@hint.Name</span><span class="syntax">@hint.Syntax</span><span class="desc">@hint.Description</span></div>
                    @if (hint.Note is { } note)
                    {
                        <div class="note"><i class="rzi" aria-hidden="true">warning</i>@note</div>
                    }
                </div>
            }
            <span class="prompt">rcon&gt;</span>
            <input @ref="_inputElement" value="@_input.Text" @oninput="OnInput" @onkeydown="OnKeyDown" @onblur="OnBlur"
                   placeholder="@(InputEnabled ? "ListPlayers, SaveWorld, Broadcast <message> …" : "Start the instance to send commands")"
                   disabled="@(!InputEnabled || _sending)" autocomplete="off" spellcheck="false" aria-label="RCON command"
                   role="combobox" aria-autocomplete="list" aria-expanded="@(listOpen ? "true" : "false")" aria-controls="@_listId"
                   aria-activedescendant="@(listOpen && _input.Highlight >= 0 ? $"{_listId}-{_input.Highlight}" : null)"
                   data-suggesting="@(listOpen ? "true" : "false")" />
            <button type="button" class="console-browse@(_input.IsBrowsing ? " is-on" : null)" title="Browse RCON commands" aria-label="Browse RCON commands"
                    aria-pressed="@(_input.IsBrowsing ? "true" : "false")" @onmousedown:preventDefault="true" @onclick="ToggleBrowse"><i class="rzi">menu_book</i></button>
            <RadzenButton Text="Send" Size="ButtonSize.Small" Variant="Variant.Outlined" ButtonStyle="ButtonStyle.Base" Disabled="@(!InputEnabled || _sending || string.IsNullOrWhiteSpace(_input.Text))" Click="SendAsync" />
        </div>
    }
</div>

@code {
    private const int Visible = 800;
    private readonly List<ConsoleLine> _lines = [];
    private readonly object _gate = new();
    private readonly RconConsoleInput _input = new();
    private readonly string _listId = $"rcon-list-{Guid.NewGuid():N}";
    private ElementReference _output;
    private ElementReference _inputElement;
    private string? _keysAttachedTo;
    private bool _follow = true;
    private bool _hasBackfill;
    private bool _renderScheduled;
    private bool _sending;
    private bool _focusAfterRender;
    private string? _subscribedChannel;
    private IReadOnlyList<string>? _appliedHistory;

    [Parameter, EditorRequired]
    public string Channel { get; set; } = string.Empty;

    [Parameter]
    public string Title { get; set; } = "Console";

    [Parameter]
    public string EmptyText { get; set; } = "Nothing yet.";

    /// <summary>CSS height of the whole panel; null lets the parent size it.</summary>
    [Parameter]
    public string? Height { get; set; }

    /// <summary>When set, a command line is shown and each entered command is passed here.</summary>
    [Parameter]
    public EventCallback<string> OnCommand { get; set; }

    [Parameter]
    public bool InputEnabled { get; set; } = true;

    /// <summary>
    /// Earlier commands for the arrow keys, oldest first. A new list replaces what the panel holds; without one the
    /// panel only remembers what was sent since it opened.
    /// </summary>
    [Parameter]
    public IReadOnlyList<string>? History { get; set; }

    protected override void OnParametersSet()
    {
        if (!ReferenceEquals(History, _appliedHistory))
        {
            _appliedHistory = History;
            _input.SetHistory(History ?? []);
        }

        if (_subscribedChannel == Channel)
        {
            return;
        }

        if (_subscribedChannel is null)
        {
            Console.LineAppended += OnLineAppended;
            Console.Cleared += OnCleared;
        }
        else
        {
            // The page was reused for another instance: its input, recalled entry, and open list do not carry over.
            _input.Reset(History ?? []);
        }

        _subscribedChannel = Channel;
        lock (_gate)
        {
            _lines.Clear();
            _lines.AddRange(Console.Snapshot(Channel));
            _hasBackfill = _lines.Any(l => l.Kind == ConsoleLineKind.Backfill);
        }
    }

    private void OnLineAppended(string channel, ConsoleLine line)
    {
        if (channel != Channel)
        {
            return;
        }

        var schedule = false;
        lock (_gate)
        {
            _lines.Add(line);
            if (_lines.Count > IConsoleService.Capacity)
            {
                _lines.RemoveRange(0, _lines.Count - IConsoleService.Capacity);
            }

            _hasBackfill |= line.Kind == ConsoleLineKind.Backfill;
            if (!_renderScheduled)
            {
                _renderScheduled = schedule = true;
            }
        }

        if (schedule)
        {
            // Coalesce bursts (the game logs dozens of lines per second while loading) into one render.
            _ = InvokeAsync(async () =>
            {
                await Task.Delay(90);
                lock (_gate)
                {
                    _renderScheduled = false;
                }

                StateHasChanged();
            });
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        try
        {
            // Arrow keys and Tab are handled here, so the browser must not also move the caret or the focus.
            if (OnCommand.HasDelegate && _inputElement.Id is { } id && id != _keysAttachedTo)
            {
                _keysAttachedTo = id;
                await JS.InvokeVoidAsync("ark.filterConsoleKeys", _inputElement);
            }

            if (_follow)
            {
                await JS.InvokeVoidAsync("ark.scrollToBottom", _output, true);
            }

            if (_focusAfterRender && !_sending)
            {
                _focusAfterRender = false;
                await JS.InvokeVoidAsync("ark.focus", _inputElement);
            }
        }
        catch (JSDisconnectedException)
        {
        }
    }

    private async Task ToggleFollow()
    {
        _follow = !_follow;
        if (_follow)
        {
            await JS.InvokeVoidAsync("ark.scrollToBottom", _output, true);
        }
    }

    private void ClearView()
    {
        lock (_gate)
        {
            _lines.Clear();
            _hasBackfill = false;
        }
    }

    private void OnCleared(string channel)
    {
        if (channel != Channel)
        {
            return;
        }

        ClearView();
        _ = InvokeAsync(StateHasChanged);
    }

    private async Task CopyAsync()
    {
        string text;
        lock (_gate)
        {
            text = string.Join('\n', _lines.Skip(Math.Max(0, _lines.Count - Visible)).Select(l => $"[{Presentation.Clock(l.At)}] {l.Text}"));
        }

        await JS.InvokeAsync<bool>("ark.copyText", text);
    }

    private void OnInput(ChangeEventArgs e) => _input.TextChanged(e.Value as string);

    private void OnBlur() => _input.Close();

    private async Task ToggleBrowse()
    {
        _input.ToggleBrowse();
        await FocusInputAsync();
    }

    private async Task AcceptAsync(RconCommandInfo command)
    {
        if (!InputEnabled)
        {
            return; // browsing works while the server is stopped; the disabled input could not be cleared again
        }

        _input.Accept(command);
        await FocusInputAsync();
    }

    private async Task OnKeyDown(KeyboardEventArgs e)
    {
        // Shift+Enter sends, as it always did; any other modified key is left to the browser.
        if (e.CtrlKey || e.AltKey || e.MetaKey || (e.ShiftKey && e.Key != "Enter"))
        {
            return;
        }

        if (_input.Key(e.Key) == RconKeyOutcome.Send)
        {
            await SendAsync();
        }
    }

    private async Task SendAsync()
    {
        var command = _input.Text.Trim();
        if (command.Length == 0 || _sending || !InputEnabled)
        {
            return;
        }

        var session = _input.Session; // the page may move to another instance while the send is in flight
        _sending = true;
        try
        {
            await OnCommand.InvokeAsync(command);
            _input.Sent(session, command);
        }
        finally
        {
            _sending = false;
        }

        // The input is disabled while a send is in flight, which drops its focus, and it is still disabled in
        // the browser until the next render; focusing here would do nothing, so it happens after that render.
        _focusAfterRender = true;
    }

    private async Task FocusInputAsync()
    {
        try
        {
            await JS.InvokeVoidAsync("ark.focus", _inputElement);
        }
        catch (JSDisconnectedException)
        {
        }
    }

    public async ValueTask DisposeAsync()
    {
        if (_subscribedChannel is not null)
        {
            Console.LineAppended -= OnLineAppended;
            Console.Cleared -= OnCleared;
        }

        if (_keysAttachedTo is not null)
        {
            try
            {
                await JS.InvokeVoidAsync("ark.releaseKeys", _inputElement);
            }
            catch (JSDisconnectedException)
            {
            }
        }
    }
}
