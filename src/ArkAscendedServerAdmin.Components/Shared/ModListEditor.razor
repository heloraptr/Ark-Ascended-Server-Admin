@* Ordered mod list: the map's own mod first (locked), locked cluster mods next (greyed), then the editable list with enable/disable, move up/down, remove, and add-from-library. Disabled entries keep their place and are left out of -mods. *@

<div class="mod-list">
    @{ var position = 0; }
    @if (MapMod is { } mapMod)
    {
        position++;
        <div class="mod-item is-locked" title="Map mod: it comes with the selected map and cannot be moved or removed.">
            <span class="order num">@position</span>
            <ModThumb Url="@mapMod.ThumbnailUrl" />
            <div class="title">
                <strong>@mapMod.Name</strong>
                <span>@mapMod.Id · from the map</span>
            </div>
            <div class="actions"><RadzenIcon Icon="lock" Style="color:var(--ark-steel-3)" /></div>
        </div>
    }
    @foreach (var item in LockedMods)
    {
        if (item.Enabled)
        {
            position++;
        }

        <div class="mod-item is-locked @(item.Enabled ? null : "is-disabled")" title="@(item.Enabled ? "Cluster mod: change it on the cluster page." : "Disabled on the cluster page; not passed to any member.")">
            <span class="order num">@(item.Enabled ? position.ToString() : "–")</span>
            <ModThumb Url="@item.Mod.ThumbnailUrl" />
            <div class="title">
                <strong>@item.Mod.Name</strong>
                <span>@item.Mod.Id · from the cluster@(item.Enabled ? null : ", disabled there")</span>
            </div>
            <div class="actions">
                @if (!item.Enabled)
                {
                    <RadzenIcon Icon="block" Style="color:var(--ark-steel-3)" title="Disabled on the cluster page; not passed to any member" />
                }
                <RadzenIcon Icon="lock" Style="color:var(--ark-steel-3)" />
            </div>
        </div>
    }
    @for (var i = 0; i < _rows.Count; i++)
    {
        var index = i;
        var row = _rows[i];
        if (row.Enabled)
        {
            position++;
        }

        <div class="mod-item @(row.Enabled ? null : "is-disabled")">
            <span class="order num">@(row.Enabled ? position.ToString() : "–")</span>
            <ModThumb Url="@row.Mod.ThumbnailUrl" />
            <div class="title">
                <strong>@row.Mod.Name</strong>
                <span>@row.Mod.Id@(row.Enabled ? (string.IsNullOrWhiteSpace(row.Mod.Summary) ? null : " · " + row.Mod.Summary) : " · disabled, not passed to the server")</span>
            </div>
            <div class="actions">
                <RadzenButton Icon="@(row.Enabled ? "toggle_on" : "toggle_off")" Size="ButtonSize.ExtraSmall" Variant="Variant.Text" ButtonStyle="@(row.Enabled ? ButtonStyle.Primary : ButtonStyle.Base)" title="@(row.Enabled ? "Disable: keep it listed but leave it out of the start command" : "Enable")" Click="() => row.Enabled = !row.Enabled" />
                <RadzenButton Icon="arrow_upward" Size="ButtonSize.ExtraSmall" Variant="Variant.Text" ButtonStyle="ButtonStyle.Base" title="Move up" Disabled="@(index == 0)" Click="() => Move(index, -1)" />
                <RadzenButton Icon="arrow_downward" Size="ButtonSize.ExtraSmall" Variant="Variant.Text" ButtonStyle="ButtonStyle.Base" title="Move down" Disabled="@(index == _rows.Count - 1)" Click="() => Move(index, 1)" />
                <RadzenButton Icon="close" Size="ButtonSize.ExtraSmall" Variant="Variant.Text" ButtonStyle="ButtonStyle.Base" title="Remove" Click="() => _rows.RemoveAt(index)" />
            </div>
        </div>
    }
    @if (MapMod is null && LockedMods.Count == 0 && _rows.Count == 0)
    {
        <p class="muted" style="padding:12px 0">No mods. The server starts vanilla.</p>
    }
</div>

<div class="form-actions" style="flex-wrap:wrap">
    <RadzenDropDown TValue="int?" @bind-Value="_pick" Data="Available" TextProperty="Name" ValueProperty="Id" FilterOperator="StringFilterOperator.Contains" FilterCaseSensitivity="FilterCaseSensitivity.CaseInsensitive" Placeholder="@(Available.Count == 0 ? "Every library mod is already listed" : "Add a mod from the library")" AllowFiltering="true" AllowClear="true" Disabled="@(Available.Count == 0)" Style="min-width:300px" />
    <RadzenButton Text="Add" Icon="add" Variant="Variant.Outlined" ButtonStyle="ButtonStyle.Base" Disabled="@(_pick is null)" Click="Add" />
    <span class="spacer" style="flex:1"></span>
    <RadzenButton Text="Save mods" Icon="save" ButtonStyle="ButtonStyle.Primary" Disabled="@(Busy || !IsDirty)" Click="SaveAsync" />
    <RadzenButton Text="Reset" Variant="Variant.Text" ButtonStyle="ButtonStyle.Base" Disabled="@(Busy || !IsDirty)" Click="Reset" />
</div>
<p class="hint muted" style="margin-top:8px">Order matters: mods load in this order, the map's own mod first, then cluster mods. A disabled mod keeps its place but is left out of the start command. Changes to the list need a restart.</p>

@code {
    /// <summary>One editable row; the enabled flag is toggled in place, so this is a class rather than a record.</summary>
    private sealed class Row(ModLibraryEntry mod, bool enabled)
    {
        public ModLibraryEntry Mod { get; } = mod;

        public bool Enabled { get; set; } = enabled;
    }

    private List<Row> _rows = [];
    private int? _pick;
    private IReadOnlyList<ModListItem>? _source;

    /// <summary>A custom map's own mod; shown locked at position 1 and never part of the saved list.</summary>
    [Parameter]
    public ModLibraryEntry? MapMod { get; set; }

    [Parameter]
    public IReadOnlyList<ModListItem> LockedMods { get; set; } = [];

    [Parameter, EditorRequired]
    public IReadOnlyList<ModListItem> Mods { get; set; } = [];

    [Parameter, EditorRequired]
    public IReadOnlyList<ModLibraryEntry> Library { get; set; } = [];

    [Parameter]
    public bool Busy { get; set; }

    [Parameter]
    public EventCallback<IReadOnlyList<ModSelection>> OnSave { get; set; }

    private IReadOnlyList<ModLibraryEntry> Available =>
        Library.Where(m => m.Id != MapMod?.Id && _rows.All(x => x.Mod.Id != m.Id) && LockedMods.All(x => x.Mod.Id != m.Id)).OrderBy(m => m.Name).ToList();

    private bool IsDirty => !_rows.Select(r => (r.Mod.Id, r.Enabled)).SequenceEqual(Mods.Select(m => (m.Mod.Id, m.Enabled)));

    protected override void OnParametersSet()
    {
        if (!ReferenceEquals(_source, Mods))
        {
            _source = Mods;
            Reset();
        }
    }

    private void Reset() => _rows = Mods.Select(m => new Row(m.Mod, m.Enabled)).ToList();

    private void Add()
    {
        if (_pick is { } id && Library.FirstOrDefault(m => m.Id == id) is { } entry)
        {
            _rows.Add(new Row(entry, enabled: true));
        }

        _pick = null;
    }

    private void Move(int index, int delta)
    {
        var target = index + delta;
        if (target < 0 || target >= _rows.Count)
        {
            return;
        }

        (_rows[index], _rows[target]) = (_rows[target], _rows[index]);
    }

    private Task SaveAsync() => OnSave.InvokeAsync(_rows.Select(r => new ModSelection(r.Mod.Id, r.Enabled)).ToList());
}
