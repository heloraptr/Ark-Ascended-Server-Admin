@* Typed -Flag options plus free-text additional arguments (plan step 17). A clustered instance can inherit each flag from its cluster. *@
@using ArkAscendedServerAdmin.Launch

<p class="hint muted" style="margin:0 0 12px">Every start also passes <code>-log -servergamelog</code>; the console depends on the log they produce, so they are not optional.</p>

<div class="flag-list">
    @foreach (var flag in _flags)
    {
        <div class="flag">
            <div>
                <span class="flag-name">@flag.Label</span>
                <span class="flag-desc">@flag.Description</span>
            </div>
            <div class="tri" role="group" aria-label="@flag.Label">
                <button type="button" class="@(flag.Get(_edit) is null ? (CanInherit ? "on is-inherit" : "on") : null)" @onclick="() => Set(flag, null)">@(CanInherit ? "Inherit" : "Default")</button>
                <button type="button" class="@(flag.Get(_edit) == true ? "on" : null)" @onclick="() => Set(flag, true)">On</button>
                <button type="button" class="@(flag.Get(_edit) == false ? "on" : null)" @onclick="() => Set(flag, false)">Off</button>
            </div>
            @if (flag.Get(_edit) is null)
            {
                <span class="flag-effective">
                    @(CanInherit ? "Inherited from the cluster: " : "Default: ")<strong>@(Effective(flag) ? "on" : "off")</strong>
                    · @(Effective(flag) ? $"passes {flag.Switch}" : $"{flag.Switch} is not passed")
                </span>
            }
        </div>
    }
</div>

<div class="form-grid" style="margin-top:18px">
    <div class="field">
        <label for="lf-platform">Server platform</label>
        <RadzenTextBox id="lf-platform" @bind-Value="_edit.ServerPlatform" Placeholder="@(CanInherit ? InheritText(ClusterBase?.ServerPlatform) : "ALL")" />
        <span class="hint">Crossplay filter passed as -ServerPlatform, e.g. ALL, PC, or PC+XSX. Leave empty for the game's default.</span>
    </div>
    <div class="field">
        <label for="lf-event">Active event</label>
        <RadzenTextBox id="lf-event" @bind-Value="_edit.ActiveEvent" Placeholder="@(CanInherit ? InheritText(ClusterBase?.ActiveEvent) : "none")" />
        <span class="hint">Seasonal event name passed as -ActiveEvent.</span>
    </div>
    <div class="field span-2">
        <label for="lf-args">Additional arguments</label>
        <RadzenTextArea id="lf-args" @bind-Value="_edit.AdditionalArgs" @bind-Value:after="ValidateArgs" Rows="3" Placeholder="-culture=en -ForceRespawnDinos" />
        <span class="hint">
            Free text appended after the manager's own options. Options the manager owns (-port, -mods, -clusterid, the typed flags above) and anything containing a question mark are rejected.
            @if (CanInherit && !string.IsNullOrWhiteSpace(ClusterBase?.AdditionalArgs))
            {
                <text>The cluster adds <code>@ClusterBase!.AdditionalArgs</code> first.</text>
            }
        </span>
    </div>
</div>

<Problems Items="_problems" />

<div class="form-actions">
    <RadzenButton Text="Save launch options" Icon="save" ButtonStyle="ButtonStyle.Primary" Disabled="@(Busy || _problems.Count > 0)" Click="SaveAsync" />
    <RadzenButton Text="Reset" Variant="Variant.Text" ButtonStyle="ButtonStyle.Base" Disabled="Busy" Click="Reset" />
    @if (Extra is not null)
    {
        @Extra
    }
</div>

@code {
    // Switch: the command-line switch "on" passes. DefaultOn: what "Default" resolves to on a standalone instance or a cluster.
    private sealed record FlagSpec(string Label, string Switch, string Description, Func<LaunchFlags, bool?> Get, Action<LaunchFlags, bool?> Set, bool DefaultOn);

    private static readonly FlagSpec[] _flags =
    [
        new("BattlEye disabled", "-NoBattlEye", "The anti-cheat is skipped; it only matters for public servers. Off enables BattlEye.", f => f.NoBattlEye, (f, v) => f.NoBattlEye = v, true),
        new("Tribe logs in game log", "-ServerGameLogIncludeTribeLogs", "Tribe events are written into ShooterGame.log, so they show in the console.", f => f.ServerGameLogIncludeTribeLogs, (f, v) => f.ServerGameLogIncludeTribeLogs = v, false),
        new("Tribe logs over RCON", "-ServerRconOutputTribeLogs", "Tribe events are also sent to RCON clients.", f => f.ServerRconOutputTribeLogs, (f, v) => f.ServerRconOutputTribeLogs = v, false),
        new("Exclusive join", "-exclusivejoin", "Only whitelisted players can join.", f => f.ExclusiveJoin, (f, v) => f.ExclusiveJoin = v, false),
        new("No wild babies", "-NoWildBabies", "Wild creatures never spawn as babies.", f => f.NoWildBabies, (f, v) => f.NoWildBabies = v, false),
        new("Prevent spawn animations", "-PreventSpawnAnimations", "Players and creatures appear without the spawn-in animation.", f => f.PreventSpawnAnimations, (f, v) => f.PreventSpawnAnimations = v, false),
        new("Use store", "-UseStore", "Player profiles are kept in the cluster's store rather than per server.", f => f.UseStore, (f, v) => f.UseStore = v, false),
        new("Convert to store", "-ConvertToStore", "One-time migration of existing profiles into the store; turn it off again after one start.", f => f.ConvertToStore, (f, v) => f.ConvertToStore = v, false),
    ];

    private LaunchFlags _edit = new();
    private IReadOnlyList<string> _problems = [];
    private LaunchFlags? _source;

    /// <summary>The persisted flags; edited on a copy until saved.</summary>
    [Parameter, EditorRequired]
    public LaunchFlags Flags { get; set; } = default!;

    /// <summary>The cluster's flags when editing a clustered instance; enables "Inherit".</summary>
    [Parameter]
    public LaunchFlags? ClusterBase { get; set; }

    [Parameter]
    public bool CanInherit { get; set; }

    [Parameter]
    public bool Busy { get; set; }

    [Parameter]
    public EventCallback<LaunchFlags> OnSave { get; set; }

    /// <summary>Extra buttons rendered next to Save (the instance page puts "Preview" here).</summary>
    [Parameter]
    public RenderFragment? Extra { get; set; }

    protected override void OnParametersSet()
    {
        if (!ReferenceEquals(_source, Flags))
        {
            _source = Flags;
            Reset();
        }
    }

    private void Reset()
    {
        _edit = new LaunchFlags();
        Copy(Flags, _edit);
        ValidateArgs();
    }

    private bool Effective(FlagSpec flag)
    {
        var resolved = LaunchFlagResolver.Resolve(ClusterBase, _edit);
        return flag.Get(resolved) ?? flag.DefaultOn;
    }

    private void Set(FlagSpec flag, bool? value) => flag.Set(_edit, value);

    private void ValidateArgs() => _problems = AdditionalArgs.Validate(_edit.AdditionalArgs);

    private static string InheritText(string? clusterValue) => string.IsNullOrWhiteSpace(clusterValue) ? "inherit (unset)" : $"inherit: {clusterValue}";

    private async Task SaveAsync()
    {
        ValidateArgs();
        if (_problems.Count > 0)
        {
            return;
        }

        var copy = new LaunchFlags();
        Copy(_edit, copy);
        await OnSave.InvokeAsync(copy);
    }

    private static void Copy(LaunchFlags from, LaunchFlags to)
    {
        to.NoBattlEye = from.NoBattlEye;
        to.ServerPlatform = from.ServerPlatform;
        to.ExclusiveJoin = from.ExclusiveJoin;
        to.NoWildBabies = from.NoWildBabies;
        to.PreventSpawnAnimations = from.PreventSpawnAnimations;
        to.UseStore = from.UseStore;
        to.ConvertToStore = from.ConvertToStore;
        to.ServerGameLogIncludeTribeLogs = from.ServerGameLogIncludeTribeLogs;
        to.ServerRconOutputTribeLogs = from.ServerRconOutputTribeLogs;
        to.ActiveEvent = from.ActiveEvent;
        to.AdditionalArgs = from.AdditionalArgs;
    }
}
